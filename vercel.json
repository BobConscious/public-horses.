{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "{server/schema.sql,server/fixtures/city-sunset.webp,public/maps/places.json}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/preview" },
    { "source": "/:page(about|design-system|garden|workspace|review|sign-in|sign-up)", "destination": "/index.html" },
    { "source": "/projects/:slug", "destination": "/index.html" },
    { "source": "/profiles/:slug", "destination": "/index.html" }
  ]
}
